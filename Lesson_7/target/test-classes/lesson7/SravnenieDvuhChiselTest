package lesson7;

import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

class CompareNumbersTest {

    CompareNumbers compareNumbers = new CompareNumbers();

    @Test
    void testGreater() {
        assertEquals("10 больше 5", compareNumbers.compare(10, 5));
    }

    @Test
    void testLess() {
        assertEquals("5 меньше 10", compareNumbers.compare(5, 10));
    }

    @Test
    void testEqual() {
        assertEquals("7 равно 7", compareNumbers.compare(7, 7));
    }
}