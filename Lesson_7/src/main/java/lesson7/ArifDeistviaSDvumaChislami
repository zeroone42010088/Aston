package lesson7;

public class ArithmeticOperations {

    public static int add(int a, int b) { return a + b; }
    public static int subtract(int a, int b) { return a - b; }
    public static int multiply(int a, int b) { return a * b; }
    public static double divide(int a, int b) {
        if (b == 0) throw new ArithmeticException("Деление на ноль невозможно");
        return (double) a / b;
    }

    public static void main(String[] args) {
        int x = 10, y = 2;
        System.out.println("Сумма: " + add(x, y));
        System.out.println("Разность: " + subtract(x, y));
        System.out.println("Произведение: " + multiply(x, y));
        System.out.println("Деление: " + divide(x, y));
    }
}