public class Main {
public static void lesson13Diagonal() {
    int size = 5;
    int [][] array = new int[size][size];

    for (int i = 0; i < size; i++) {
        array[i][i]=1;
    }

    for (int i = 0; i < size; i++) {
        for (int j=0; j < size; j++) {
            System.out.print(array[i][j] + " ");
        }
        System.out.println();
    }
    }
    }



      
