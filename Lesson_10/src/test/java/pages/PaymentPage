package pages;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;

public class PaymentPage extends BasePage {

    // Варианты оплаты
    private By mobileServicesTab = By.xpath("//button[contains(text(),'Услуги связи')]");
    private By homeInternetTab = By.xpath("//button[contains(text(),'Домашний интернет')]");
    private By installmentTab = By.xpath("//button[contains(text(),'Рассрочка')]");
    private By debtTab = By.xpath("//button[contains(text(),'Задолженность')]");

    // Поля формы
    private By phoneInput = By.xpath("//input[contains(@placeholder,'Номер')]");
    private By amountInput = By.xpath("//input[contains(@placeholder,'Сумма')]");
    private By emailInput = By.xpath("//input[contains(@placeholder,'E-mail')]");
    private By continueButton = By.xpath("//button[contains(text(),'Продолжить')]");

    // Ошибки
    private By fieldError = By.xpath("//*[contains(@class,'error') or contains(text(),'Введите')]");

    // Элементы подтверждения
    private By confirmationAmount = By.xpath("//div[contains(@class,'amount')]");
    private By confirmationPhone = By.xpath("//div[contains(@class,'phone')]");
    private By cardFields = By.xpath("//input[contains(@placeholder,'Номер карты')]");
    private By paymentIcons = By.xpath("//div[contains(@class,'payment-icons')]");

    public PaymentPage(WebDriver driver) {
        super(driver);
    }

    public void selectTab(String tabName) {
        switch(tabName) {
            case "Услуги связи": click(mobileServicesTab); break;
            case "Домашний интернет": click(homeInternetTab); break;
            case "Рассрочка": click(installmentTab); break;
            case "Задолженность": click(debtTab); break;
        }
    }

    public void fillMobileForm(String phone, String amount, String email) {
        type(phoneInput, phone);
        type(amountInput, amount);
        type(emailInput, email);
    }

    public void clickContinue() {
        click(continueButton);
    }

    public boolean isErrorDisplayed() {
        return isDisplayed(fieldError);
    }

    public String getConfirmationAmount() {
        return getText(confirmationAmount);
    }

    public String getConfirmationPhone() {
        return getText(confirmationPhone);
    }

    public boolean isCardFieldsDisplayed() {
        return isDisplayed(cardFields);
    }

    public boolean arePaymentIconsDisplayed() {
        return isDisplayed(paymentIcons);
    }
}