package pages;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;

public class ConfirmationPage extends BasePage {

    private By amountText = By.xpath("//div[contains(@class,'amount')]");
    private By phoneText = By.xpath("//div[contains(@class,'phone')]");
    private By cardFields = By.xpath("//input[contains(@placeholder,'Номер карты')]");
    private By paymentIcons = By.xpath("//div[contains(@class,'payment-icons')]");

    public ConfirmationPage(WebDriver driver) {
        super(driver);
    }

    public String getAmount() { return getText(amountText); }
    public String getPhone() { return getText(phoneText); }
    public boolean isCardFieldVisible() { return isDisplayed(cardFields); }
    public boolean arePaymentIconsVisible() { return isDisplayed(paymentIcons); }
}

package pages.ConfirmationPage;

import io.qameta.allure.Step;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.support.FindBy;
import pages.BasePage.BasePage;

public class ConfirmationPage extends BasePage {

    @FindBy(xpath="//div[contains(@class,'confirmation')]")
    private WebElement confirmationPopup;

    public ConfirmationPage(WebDriver driver) {
        super(driver);
    }

    @Step("Проверить наличие поп-апа подтверждения")
    public boolean isConfirmationDisplayed() {
        return confirmationPopup.isDisplayed();
    }
}