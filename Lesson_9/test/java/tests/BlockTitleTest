import org.junit.jupiter.api.Test;
import org.openqa.selenium.By;
import org.openqa.selenium.WebElement;

import static org.junit.jupiter.api.Assertions.assertEquals;

public class BlockTitleTest extends BaseTest {

    @Test
    void checkBlockTitle() {
        WebElement title = driver.findElement(By.xpath("//*[contains(text(),'Онлайн пополнение без комиссии')]"));
        assertEquals("Онлайн пополнение без комиссии", title.getText());
    }
}